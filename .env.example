VITE_API_URL=http://localhost:5171

# Level II mosaic defaults. ALL resolves every station from
# data/nexrad_stations.csv that falls inside (or within radar range of) the
# bounds; set an explicit comma-separated ID list to run a smaller region.
ORION_NEXRAD_BUCKET=unidata-nexrad-level2
ORION_RADAR_STATIONS=ALL
ORION_RADAR_BOUNDS=-125.0,24.0,-66.5,49.5
ORION_RADAR_RESOLUTION_M=2000
ORION_RADAR_MIN_ZOOM=4
ORION_RADAR_MAX_ZOOM=9
ORION_RADAR_INGEST_LAG_SECONDS=600
ORION_RADAR_SCAN_WINDOW_SECONDS=1800
ORION_RADAR_SCAN_TOLERANCE_SECONDS=240
ORION_RADAR_MIN_STATIONS=2
ORION_RADAR_RANGE_KM=230
ORION_RADAR_INTERVAL_SECONDS=300
ORION_RADAR_RETAINED_FRAMES=13
# Resource limits. Ingest workers bound peak memory (~70 MB per concurrent
# scan) and peak raw-cache size; compute workers bound CPU.
ORION_RADAR_INGEST_WORKERS=8
ORION_RADAR_COMPUTE_WORKERS=5
# Level II volumes are deleted the moment they are decoded, so the cache holds
# only what is in flight. Set ORION_RADAR_KEEP_RAW=true to retain them for
# backfills or offline debugging; the retention window then bounds the cache,
# and is otherwise just a backstop for volumes a failed decode left behind.
ORION_RADAR_KEEP_RAW=false
ORION_RADAR_RAW_RETENTION_SECONDS=1800
