# Only what an operator usually changes. Everything else has a code default; the
# full list lives in src/services/nexrad/settings.py.

# Release version used for image tags in compose; unset follows `latest`.
ORION_VERSION=latest

# Where the GUI calls the API, read at runtime so the published image works for
# any host: unset means the same origin serves the API at /api.
PUBLIC_ORION_API_URL=http://localhost:5171/api

# Origins allowed to call the API. Empty behind a proxy that sets its own CORS.
ORION_CORS_ORIGINS=http://localhost:5173

# ALL resolves every station in data/nexrad_stations.csv that falls inside (or
# within radar range of) the bounds; set a comma-separated ID list to run a
# smaller region. Narrow these two together to cut ingest cost.
# ALL resolves every station inside (or within radar range of) the bounds, so
# narrowing the bounds is what keeps the first frame fast. The default is the
# Tennessee Valley; -125.0,24.0,-66.5,49.5 is full CONUS.
ORION_NEXRAD_STATIONS=ALL
ORION_NEXRAD_BOUNDS=-91.5,33.0,-81.0,39.0

# How much playback history to keep. The frame count follows from this and the
# cycle interval: 6 hours at 300s is 72 frames.
ORION_NEXRAD_HISTORY_HOURS=6

# Worker counts size themselves from the container's CPU allocation and rarely
# need setting. Ingest bounds peak memory (roughly one decoded sweep each).
# ORION_NEXRAD_INGEST_WORKERS=
# ORION_NEXRAD_COMPUTE_WORKERS=

# Level II volumes are deleted the moment they are decoded, so the cache holds
# only what is in flight. Set true to retain them for backfills or offline
# debugging; the retention window then bounds the cache, and is otherwise just
# a backstop for volumes a failed decode left behind.
# ORION_NEXRAD_KEEP_RAW=false
# ORION_NEXRAD_RAW_RETENTION_SECONDS=1800
